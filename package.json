{
  "name": "svg-editor-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Object-oriented TypeScript CLI SVG editor for Lab1 Phase 1",
  "type": "module",
  "bin": {
    "svg-editor": "dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
